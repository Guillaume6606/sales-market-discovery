FROM mcr.microsoft.com/playwright:v1.55.0-noble

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies as root
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libgl1-mesa-dri mesa-vulkan-drivers libdrm2 libgbm1 \
    python3 python3-pip python3-venv \
    curl wget \
    fontconfig \
    fonts-noto-extra \
    locales tzdata \
    fonts-dejavu-core fonts-dejavu-extra \
    fonts-liberation \
    fonts-noto-core fonts-noto-color-emoji \
    fonts-cantarell fonts-freefont-ttf fonts-urw-base35 \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /usr/local/bin/uv

# Set work directory
WORKDIR /app

# Copy and install Python dependencies (--chown ensures pwuser ownership)
COPY --chown=pwuser:pwuser pyproject.toml uv.lock README.md ./
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN uv sync --frozen --no-dev --no-install-project
RUN .venv/bin/patchright install chromium

# Copy application code
COPY --chown=pwuser:pwuser ingestion ./ingestion
COPY --chown=pwuser:pwuser libs ./libs
RUN uv sync --frozen --no-dev --no-editable
COPY --chown=pwuser:pwuser test-stealth-config.py /app/test-stealth-config.py
COPY --chown=pwuser:pwuser infra/docker/start-ingestion.sh /start-ingestion.sh

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 TZ=Europe/Paris
RUN chmod +x /start-ingestion.sh

# Pre-create the Chromium profile dir with correct ownership so the
# pwuser-data named volume initializes pwuser-owned (else Docker creates
# it root-owned and Chromium fails on SingletonLock).
RUN mkdir -p /tmp/pwuser && chown pwuser:pwuser /tmp/pwuser

USER pwuser

ENV PYTHONPATH="/app" PATH="/app/.venv/bin:$PATH"

CMD ["/start-ingestion.sh"]
