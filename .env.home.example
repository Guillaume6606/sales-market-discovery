# Home ingestion node (docker-compose.home.yml) — see docs/home-worker.md.
# Start from a copy of the VPS .env (LLM, vision, Telegram and alert settings must match:
# the home worker runs details, PMN, scoring and alert evaluation for its products),
# then override the keys below. Never commit .env.home.

# Same value as REMOTE_PROVIDERS in the VPS .env. WORKER_ROLE=remote is forced by the compose file.
REMOTE_PROVIDERS=leboncoin

# VPS Tailscale IP; the VPS publishes db/redis there via the "tailnet" compose profile.
POSTGRES_HOST=100.99.53.92
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app
# REDIS_PASSWORD from the VPS .env (hex, so no URL encoding needed).
REDIS_URL=redis://:CHANGE_ME@100.99.53.92:6379/0

# Residential connection: keep empty so the paid proxy is not used.
SCRAPING_PROXY_URL=
